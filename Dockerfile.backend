FROM python:3.12-slim

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONPATH=/app \
    DAGSTER_HOME=/opt/dagster/dagster_home \
    DBT_PROFILES_DIR=/app/backend/docker/dbt

COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev --no-install-project

# --- Copy the complete backend, including dbt, data and profiles ---
COPY backend/ ./backend/
COPY data/crop_data_1965_2025.csv ./data/

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /opt/dagster/dagster_home

EXPOSE 3000

CMD ["uv", "run", "--no-sync", "dagster", "dev", "-m", "backend.orchestration.definitions", "-h", "0.0.0.0", "-p", "3000"]