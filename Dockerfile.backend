
FROM python:3.12-slim

# Install system dependencies
RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

# Application directory
WORKDIR /app

# Install uv
COPY --from=ghcr.io/astral-sh/uv:0.8.17 /uv /uvx /bin/

# Configure Python and uv
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_PROJECT_ENVIRONMENT=/app/.venv \
    PYTHONPATH=/app \
    DAGSTER_HOME=/opt/dagster/dagster_home \
    DBT_PROFILES_DIR=/app/dbt_profiles

# Install dependencies first for better Docker layer caching
COPY pyproject.toml uv.lock ./

RUN uv sync --frozen --no-dev --no-install-project

# Copy application code and supporting files
COPY backend/ ./backend/
COPY crop_analytics_dbt/ ./crop_analytics_dbt/
COPY data/ ./data/
COPY docker/dbt/profiles.yml /app/dbt_profiles/profiles.yml

# Create Dagster's persistent state directory
RUN mkdir -p /opt/dagster/dagster_home

EXPOSE 3000

CMD ["uv", "run", "--no-sync", "dagster", "dev", "-m", "backend.orchestration.definitions", "-h", "0.0.0.0", "-p", "3000"]
